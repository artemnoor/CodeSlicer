{
  "id": "language.typescript",
  "kind": "language",
  "language": "typescript",
  "version": "1.1.0",
  "file_extensions": [".ts", ".tsx"],
  "manifest_files": ["package.json", "tsconfig.json"],
  "supported_versions": [],
  "activation": {"extensions": [".ts", ".tsx"]},
  "capabilities": {"structural_extraction": true, "frontend_source_facts": true},
  "phases": ["extract", "resolve", "validate"],
  "entrypoint": "plugins.languages.typescript.plugin:create_plugin",
  "cache_key": "tree-sitter-typescript-local-semantics-v2",
  "allowed_edge_kinds": ["DECLARES", "IMPORTS", "CALLS", "DEPENDS_ON"],
  "confidence_policy": {"default": "limited"},
  "evidence_requirements": {"requires_locations": true},
  "fixtures": [],
  "local_first": true
}
