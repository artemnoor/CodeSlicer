{
  "id": "language.javascript",
  "kind": "language",
  "language": "javascript",
  "version": "1.0.0",
  "file_extensions": [".js", ".jsx"],
  "manifest_files": ["package.json"],
  "supported_versions": [],
  "activation": {"extensions": [".js", ".jsx"]},
  "capabilities": {"structural_extraction": true, "frontend_source_facts": true},
  "phases": ["extract", "resolve", "validate"],
  "entrypoint": "plugins.languages.javascript.plugin:create_plugin",
  "cache_key": "tree-sitter-javascript-v1",
  "allowed_edge_kinds": ["DECLARES", "IMPORTS", "CALLS", "DEPENDS_ON"],
  "confidence_policy": {"default": "limited"},
  "evidence_requirements": {"requires_locations": true},
  "fixtures": [],
  "local_first": true
}
