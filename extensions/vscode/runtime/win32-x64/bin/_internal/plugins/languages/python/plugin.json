{
  "id": "language.python",
  "kind": "language",
  "language": "python",
  "version": "1.0.0",
  "file_extensions": [".py"],
  "manifest_files": ["pyproject.toml", "requirements.txt"],
  "activation": {"extensions": [".py"]},
  "supported_versions": [],
  "capabilities": {"structural_extraction": true, "semantic_resolution": true},
  "phases": ["extract", "resolve", "validate"],
  "entrypoint": "plugins.languages.python.plugin:create_plugin",
  "cache_key": "python-ast-v1",
  "allowed_edge_kinds": ["DECLARES", "IMPORTS", "CALLS", "DEPENDS_ON"],
  "confidence_policy": {"default": "semantic"},
  "evidence_requirements": {"requires_locations": true},
  "fixtures": [],
  "local_first": true
}
