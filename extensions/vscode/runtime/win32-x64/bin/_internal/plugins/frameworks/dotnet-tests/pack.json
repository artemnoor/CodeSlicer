{
  "id": "framework.csharp.dotnet-tests",
  "kind": "framework",
  "language": "csharp",
  "version": "1.0.0",
  "file_extensions": [],
  "manifest_files": [".csproj", ".sln", ".slnx"],
  "activation": {"dependencies": ["Microsoft.NET.Test.Sdk", "xunit", "NUnit", "MSTest.TestFramework"], "imports": ["Xunit", "NUnit.Framework", "Microsoft.VisualStudio.TestTools.UnitTesting"]},
  "supported_versions": ["6.0+"],
  "capabilities": {"declarative_rules": true, "optional_hook": true, "hook_entrypoints": {"csharp_test_rules": "test_rules"}, "hook_phases": {"csharp_test_rules": "pre_resolution"}},
  "phases": ["resolve", "validate"],
  "entrypoint": "impact_engine.plugin_architecture.manifest_runtime:create_framework_plugin",
  "cache_key": "framework.csharp.dotnet-tests-v2",
  "allowed_edge_kinds": ["TESTS", "DEPENDS_ON"],
  "confidence_policy": {"default": "evidence_capped"},
  "evidence_requirements": {"requires_locations": true},
  "fixtures": ["tests/corpus/Cruxa"],
  "local_first": true
}
