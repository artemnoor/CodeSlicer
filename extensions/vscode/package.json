{
  "name": "codeslicer-impact-cockpit",
  "displayName": "CodeSlicer",
  "description": "See the risk, evidence, and tests behind your local Git changes before review.",
  "version": "0.6.20",
  "publisher": "CodeSlicer",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/artemnoor/CodeSlicer.git" },
  "homepage": "https://github.com/artemnoor/CodeSlicer#readme",
  "bugs": { "url": "https://github.com/artemnoor/CodeSlicer/issues" },
  "icon": "media/marketplace-icon.png",
  "galleryBanner": { "color": "#0f172a", "theme": "dark" },
  "keywords": ["codeslicer", "code review", "impact analysis", "git diff", "developer tools", "testing", "local first"],
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Testing", "Other"],
  "main": "./out/src/extension.js",
  "extensionKind": ["workspace"],
  "activationEvents": [
    "onView:codeslicer.cockpit", "onCommand:codeslicer.configureExecutable", "onCommand:codeslicer.setupSkills", "onCommand:codeslicer.analyzeWorkspace",
    "onCommand:codeslicer.reviewCurrentChanges", "onCommand:codeslicer.reviewStagedChanges", "onCommand:codeslicer.explainSelectedSymbol", "onCommand:codeslicer.openLocalHub",
    "onCommand:codeslicer.refresh", "onCommand:codeslicer.runRecommendedTest", "onCommand:codeslicer.startLocalServer"
  ],
  "contributes": {
    "viewsContainers": { "activitybar": [{ "id": "codeslicer", "title": "CodeSlicer", "icon": "media/codeslicer.svg" }] },
    "views": { "codeslicer": [{ "type": "webview", "id": "codeslicer.cockpit", "name": "Impact cockpit" }] },
    "commands": [
      { "command": "codeslicer.configureExecutable", "title": "CodeSlicer: Configure executable" },
      { "command": "codeslicer.runtimeDoctor", "title": "CodeSlicer: Check runtime" },
      { "command": "codeslicer.runtimeUpdate", "title": "CodeSlicer: Update runtime" },
      { "command": "codeslicer.runtimeRollback", "title": "CodeSlicer: Roll back runtime" },
      { "command": "codeslicer.installRuntime", "title": "CodeSlicer: Check bundled runtime" },
      { "command": "codeslicer.setupSkills", "title": "CodeSlicer: Choose IDE and install skills" },
      { "command": "codeslicer.analyzeWorkspace", "title": "CodeSlicer: Analyze workspace" },
      { "command": "codeslicer.reviewCurrentChanges", "title": "CodeSlicer: Review current changes" },
      { "command": "codeslicer.reviewStagedChanges", "title": "CodeSlicer: Review staged changes" },
      { "command": "codeslicer.reviewCompare", "title": "CodeSlicer: Compare with base branch" },
      { "command": "codeslicer.reviewDiffFile", "title": "CodeSlicer: Review a diff file" },
      { "command": "codeslicer.showReviewHistory", "title": "CodeSlicer: Show local review history" },
      { "command": "codeslicer.githubSignIn", "title": "CodeSlicer: Review GitHub pull request (optional)" },
      { "command": "codeslicer.explainSelectedSymbol", "title": "CodeSlicer: Explain selected symbol" },
      { "command": "codeslicer.openLocalHub", "title": "CodeSlicer: Open Local Hub" },
      { "command": "codeslicer.startLocalServer", "title": "CodeSlicer: Start local server" },
      { "command": "codeslicer.refresh", "title": "CodeSlicer: Refresh" },
      { "command": "codeslicer.runRecommendedTest", "title": "CodeSlicer: Run recommended test" },
      { "command": "codeslicer.gitCreateBranch", "title": "CodeSlicer: Create Git branch" },
      { "command": "codeslicer.gitSwitchBranch", "title": "CodeSlicer: Switch Git branch" },
      { "command": "codeslicer.gitPreviewPush", "title": "CodeSlicer: Preview Git push" },
      { "command": "codeslicer.gitPushBranch", "title": "CodeSlicer: Push Git branch" },
      { "command": "codeslicer.configureGitHubToken", "title": "CodeSlicer: Store GitHub token securely" }
    ],
    "configuration": {
      "title": "CodeSlicer",
      "properties": {
        "codeslicer.executable": { "type": "string", "default": "", "description": "Advanced/developer fallback only: absolute path to an existing local codeslicer executable. The bundled platform runtime is the normal path." },
        "codeslicer.baseRef": { "type": "string", "default": "", "description": "Optional explicit Git base ref. Otherwise CodeSlicer verifies and selects a safe local base." },
        "codeslicer.codeLens": { "type": "boolean", "default": false, "description": "Show the optional CodeSlicer review CodeLens. It never starts analysis automatically." },
        "codeslicer.localHubUrl": { "type": "string", "default": "http://127.0.0.1:8001/", "description": "Loopback URL where CodeSlicer starts its local Local Hub server." },
        "codeslicer.graphifyExecutable": { "type": "string", "default": "", "description": "Advanced: absolute path to the local Graphify executable. By default, CodeSlicer uses graphify from PATH." },
        "codeslicer.graphifyGraphPath": { "type": "string", "default": "", "description": "Optional absolute path to an existing Graphify graph.json. It remains separate from CodeSlicer evidence." },
        "codeslicer.packRegistryUrl": { "type": "string", "default": "", "description": "Advanced: HTTPS URL of the official signed CodeSlicer language-pack catalog. No request is made until a future explicit pack action." },
        "codeslicer.uiLanguage": { "type": "string", "default": "auto", "enum": ["auto", "ru", "en"], "enumDescriptions": ["Follow VS Code language", "Русский", "English"], "description": "Language of the CodeSlicer cockpit." }
      }
    }
  },
  "scripts": { "compile": "tsc -p .", "watch": "tsc -watch -p .", "test": "npm run compile && node --test out/test/*.test.js", "package": "npm run compile && node scripts/package-target.mjs win32-x64", "package:target": "npm run compile && node scripts/package-target.mjs" },
  "devDependencies": { "@types/node": "^20.11.30", "@types/vscode": "^1.85.0", "@vscode/vsce": "^3.2.1", "typescript": "^5.4.5" }
}
